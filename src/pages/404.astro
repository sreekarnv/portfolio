---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="404 | Page Not Found" description="The page you're looking for doesn't exist.">
  <main class="error-page">
    <div class="error-page__content">
      <span class="error-page__code">404</span>
      <h1 class="error-page__title">Page not found</h1>
      <p class="error-page__description">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="error-page__cta">
        Back to home
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </main>
</Layout>

<style lang="scss">
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl) var(--container-padding);
  }

  .error-page__content {
    text-align: left;
    max-width: 480px;
  }

  .error-page__code {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-lg);
  }

  .error-page__title {
    font-size: var(--text-4xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .error-page__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .error-page__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
    font-size: var(--text-base);
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 4px;
    transition: gap var(--duration-fast) var(--ease-out-quart);
  }

  .error-page__cta:hover {
    gap: var(--space-md);
  }
</style>
