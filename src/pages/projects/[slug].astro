---
import { getCollection } from "astro:content";
import Layout from "~/layouts/Layout.astro";
import Button from "~/components/ui/Button.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { data } = project;
---

<Layout
  title={`${data.title} | Sreekar Nutulapati`}
  description={data.description}
>
  <main class="project-detail">
    <div class="project-detail__container">
      <a href="/#projects" class="project-detail__back">
        <span aria-hidden="true">&larr;</span>
        <span>Back to projects</span>
      </a>

      <header class="project-detail__header">
        <span class="project-detail__meta">Project</span>
        <h1 class="project-detail__title">{data.title}</h1>
        <p class="project-detail__subtitle">{data.subtitle}</p>
        <p class="project-detail__description">{data.description}</p>
        <p class="project-detail__tech">
          {data.tech.map((t) => t.name).join(" · ")}
        </p>
      </header>

      <div class="project-detail__links">
        <Button href={data.github} icon="lucide:github" external>
          View source
        </Button>
        {
          data.liveDemo && (
            <Button href={data.liveDemo} icon="lucide:external-link" external>
              Live demo
            </Button>
          )
        }
        {
          data.docs && (
            <Button href={data.docs} icon="lucide:book-open" external>
              Documentation
            </Button>
          )
        }
      </div>

      {
        data.screenshots && data.screenshots.length > 0 && (
          <div class="project-detail__screenshots">
            {data.screenshots.map((src, i) => (
              <img
                src={src}
                alt={`${data.title} screenshot ${i + 1}`}
                class="project-detail__screenshot"
                loading={i === 0 ? "eager" : "lazy"}
              />
            ))}
          </div>
        )
      }

      <article class="project-detail__content prose">
        <Content />
      </article>

      <div class="project-detail__footer">
        <a href="/#projects" class="project-detail__back">
          <span aria-hidden="true">&larr;</span>
          <span>Back to all projects</span>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style lang="scss">
  .project-detail {
    padding: var(--space-5xl) 0 var(--space-3xl);

    &__container {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    &__back {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      color: var(--color-text-secondary);
      font-size: var(--text-sm);
      margin-bottom: var(--space-2xl);
      transition: color var(--duration-fast) ease, gap var(--duration-fast) ease;

      &:hover {
        color: var(--color-text);
        gap: var(--space-md);
      }
    }

    &__header {
      padding-bottom: var(--space-2xl);
      border-bottom: 1px solid var(--color-divider);
      margin-bottom: var(--space-2xl);
    }

    &__meta {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: var(--space-md);
    }

    &__title {
      font-size: var(--text-5xl);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin-bottom: var(--space-md);

      @media (max-width: 768px) {
        font-size: var(--text-4xl);
      }
    }

    &__subtitle {
      font-size: var(--text-lg);
      color: var(--color-text-secondary);
      margin-bottom: var(--space-md);
    }

    &__description {
      font-size: var(--text-base);
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-md);
    }

    &__tech {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      letter-spacing: 0.02em;
    }

    &__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-lg);
      margin-bottom: var(--space-3xl);
    }

    &__screenshots {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
      margin-bottom: var(--space-3xl);
    }

    &__screenshot {
      width: 100%;
      border: 1px solid var(--color-divider);
    }

    &__content {
      margin-bottom: var(--space-3xl);
    }

    &__footer {
      display: flex;
      justify-content: flex-start;
      padding-top: var(--space-2xl);
      border-top: 1px solid var(--color-divider);
    }
  }

  .prose {
    :global(h2) {
      font-size: var(--text-2xl);
      font-weight: 600;
      letter-spacing: -0.01em;
      margin: var(--space-2xl) 0 var(--space-md);
      color: var(--color-text);
    }

    :global(h3) {
      font-size: var(--text-lg);
      font-weight: 600;
      margin: var(--space-xl) 0 var(--space-md);
      color: var(--color-text);
    }

    :global(p) {
      color: var(--color-text-secondary);
      line-height: 1.8;
      margin-bottom: var(--space-md);
    }

    :global(ul),
    :global(ol) {
      padding: 0;
      margin: var(--space-md) 0 var(--space-lg);
    }

    :global(li) {
      position: relative;
      padding-left: var(--space-lg);
      color: var(--color-text-secondary);
      margin-bottom: var(--space-sm);
      line-height: 1.7;

      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.75em;
        width: 6px;
        height: 1px;
        background: var(--color-text-muted);
      }
    }

    :global(strong) {
      color: var(--color-text);
      font-weight: 600;
    }

    :global(code) {
      font-family: var(--font-mono);
      font-size: 0.9em;
      padding: 0.15em 0.4em;
      background: var(--color-secondary);
      color: var(--color-text);
    }

    :global(pre) {
      background: var(--color-secondary);
      padding: var(--space-lg);
      overflow-x: auto;
      margin: var(--space-lg) 0;
      border: 1px solid var(--color-divider);

      :global(code) {
        padding: 0;
        background: none;
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
      }
    }

    :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--space-lg) 0;
      font-size: var(--text-sm);
    }

    :global(th),
    :global(td) {
      padding: var(--space-sm) var(--space-md);
      text-align: left;
      border-bottom: 1px solid var(--color-divider);
    }

    :global(th) {
      color: var(--color-text);
      font-weight: 600;
    }

    :global(td) {
      color: var(--color-text-secondary);
    }

    :global(blockquote) {
      border-left: 2px solid var(--color-text);
      padding-left: var(--space-lg);
      margin: var(--space-lg) 0;
      color: var(--color-text-secondary);
    }

    :global(hr) {
      border: none;
      border-top: 1px solid var(--color-divider);
      margin: var(--space-2xl) 0;
    }

    :global(a) {
      color: var(--color-text);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
    }
  }
</style>
