---
import { Icon } from "astro-icon/components";

interface Props {
  href?: string;
  icon?: string;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  icon,
  external = false,
  class: className,
  ...rest
} = Astro.props;

const Element = href ? "a" : "button";
const externalProps = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Element
  href={href}
  class:list={["link", className]}
  {...externalProps}
  {...rest}
>
  <span class="link__text">
    <slot />
  </span>
  {icon && <Icon name={icon} class="link__icon" size={18} />}
</Element>

<style lang="scss">
  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
    font-size: var(--text-base);
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 4px;
    cursor: pointer;
    transition: gap var(--duration-fast) var(--ease-out-quart);

    &__icon {
      transition: transform var(--duration-fast) var(--ease-out-quart);
    }

    &:hover {
      gap: var(--space-md);

      .link__icon {
        transform: translate(2px, -2px);
      }
    }
  }
</style>
