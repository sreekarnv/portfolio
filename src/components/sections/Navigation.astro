---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const navLinks = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
];
---

<nav class:list={["nav", className]} id="nav">
  <a href="#hero" class="nav__logo">SN</a>

  <div class="nav__menu">
    {
      navLinks.map((link) => (
        <a href={link.href} class="nav__link">
          {link.label}
        </a>
      ))
    }
    <a href="#contact" class="nav__link nav__link--cta">Contact</a>
  </div>

  <button class="nav__toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
    <span class="nav__toggle-bar"></span>
    <span class="nav__toggle-bar"></span>
  </button>
</nav>

<style lang="scss">
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--space-md) var(--container-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid transparent;
    background: transparent;
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
    transition:
      background var(--duration-normal) ease,
      backdrop-filter var(--duration-normal) ease,
      -webkit-backdrop-filter var(--duration-normal) ease,
      border-color var(--duration-fast) ease,
      padding var(--duration-fast) ease;

    &--scrolled {
      background: rgba(10, 10, 11, 0.65);
      -webkit-backdrop-filter: blur(var(--blur-md)) saturate(180%);
      backdrop-filter: blur(var(--blur-md)) saturate(180%);
      border-bottom-color: var(--color-divider);
    }

    &__logo {
      font-family: var(--font-mono);
      font-size: var(--text-base);
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--color-text);
    }

    &__menu {
      display: flex;
      align-items: center;
      gap: var(--space-xl);
    }

    &__link {
      font-size: var(--text-sm);
      color: var(--color-text-secondary);
      transition: color var(--duration-fast) ease;

      &:hover {
        color: var(--color-text);
      }

      &--cta {
        color: var(--color-text);
        padding: var(--space-xs) var(--space-md);
        border: 1px solid var(--color-divider);
        border-radius: var(--radius-full);
        transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease;

        &:hover {
          border-color: var(--color-text);
        }
      }
    }

    &__toggle {
      position: relative;
      width: 32px;
      height: 32px;
      display: none;
      padding: 0;
    }

    &__toggle-bar {
      position: absolute;
      left: 4px;
      width: 24px;
      height: 1px;
      background: var(--color-text);
      transition: transform var(--duration-fast) var(--ease-out-quart);

      &:first-child {
        top: 12px;
      }

      &:last-child {
        bottom: 12px;
      }
    }

    &__toggle--active &__toggle-bar {
      &:first-child {
        top: 15px;
        transform: rotate(45deg);
      }

      &:last-child {
        bottom: 16px;
        transform: rotate(-45deg);
      }
    }

    @media (max-width: 768px) {
      &__menu {
        display: none;
      }

      &__toggle {
        display: block;
      }
    }
  }
</style>
