---
import { Icon } from "astro-icon/components";

interface Social {
  href: string;
  label: string;
  icon: string;
}

const socials: Social[] = [
  { href: "https://github.com/sreekarnv", label: "GitHub", icon: "mdi:github" },
  { href: "https://linkedin.com/in/sreekarnv", label: "LinkedIn", icon: "mdi:linkedin" },
  { href: "mailto:sreekarnv1@gmail.com", label: "Email", icon: "lucide:mail" },
];
---

<section class="hero" id="hero">
  <div class="hero__container">
    <span class="hero__eyebrow">Sreekar Nutulapati &middot; Portfolio</span>

    <h1 class="hero__title">
      Full Stack <span class="hero__title-accent">Developer.</span>
    </h1>

    <p class="hero__lede">
      I build scalable backend systems and the interfaces people actually
      enjoy using. Working across Python, TypeScript, and whatever the
      problem calls for.
    </p>

    <div class="hero__actions">
      <a href="#projects" class="hero__action">
        View work
        <Icon name="lucide:arrow-right" size={18} />
      </a>
      <a href="#contact" class="hero__action hero__action--muted">
        Get in touch
      </a>
    </div>

    <div class="hero__meta">
      {
        socials.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith("http") ? "_blank" : undefined}
            rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="hero__social"
            aria-label={social.label}
          >
            <Icon name={social.icon} size={18} />
            <span>{social.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    padding: var(--space-5xl) 0 var(--space-4xl);

    &__container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    &__eyebrow {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: var(--space-2xl);
    }

    &__title {
      font-size: var(--text-6xl);
      font-weight: 600;
      line-height: 1.02;
      letter-spacing: -0.04em;
      color: var(--color-text);
      margin-bottom: var(--space-xl);
      max-width: 14ch;
    }

    &__title-accent {
      color: var(--color-text-muted);
    }

    &__lede {
      font-size: var(--text-lg);
      line-height: 1.6;
      color: var(--color-text-secondary);
      max-width: 56ch;
      margin-bottom: var(--space-2xl);
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xl);
      align-items: center;
      margin-bottom: var(--space-3xl);
    }

    &__action {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      font-size: var(--text-base);
      color: var(--color-text);
      border-bottom: 1px solid var(--color-text);
      padding-bottom: 4px;
      transition: gap var(--duration-fast) var(--ease-out-quart);

      svg {
        transition: transform var(--duration-fast) var(--ease-out-quart);
      }

      &:hover {
        gap: var(--space-md);

        svg {
          transform: translateX(2px);
        }
      }

      &--muted {
        color: var(--color-text-muted);
        border-bottom-color: transparent;

        &:hover {
          color: var(--color-text);
        }
      }
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-lg);
      padding-top: var(--space-xl);
      border-top: 1px solid var(--color-divider);
    }

    &__social {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      transition: color var(--duration-fast) ease;

      &:hover {
        color: var(--color-text);
      }
    }
  }
</style>
