---
import { Icon } from "astro-icon/components";

interface ContactLink {
  href: string;
  icon: string;
  label: string;
  value: string;
}

const contactLinks: ContactLink[] = [
  {
    href: "mailto:sreekarnv1@gmail.com",
    icon: "lucide:mail",
    label: "Email",
    value: "sreekarnv1@gmail.com",
  },
  {
    href: "https://linkedin.com/in/sreekarnv",
    icon: "mdi:linkedin",
    label: "LinkedIn",
    value: "linkedin.com/in/sreekarnv",
  },
  {
    href: "https://github.com/sreekarnv",
    icon: "mdi:github",
    label: "GitHub",
    value: "github.com/sreekarnv",
  },
];

const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<section class="contact" id="contact">
  <div class="contact__container">
    <header class="contact__header">
      <span class="contact__tag">04 &mdash; Contact</span>
      <h2 class="contact__title">Let's build something.</h2>
      <p class="contact__lede">
        Have a project in mind, a role to discuss, or just want to say hi?
        I'm always open to new conversations.
      </p>
    </header>

    <div class="contact__grid">
      <div class="contact__info">
        <h3 class="contact__info-title">Find me on</h3>
        <ul class="contact__links">
          {
            contactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="contact__link"
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    link.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  <Icon name={link.icon} size={20} />
                  <div class="contact__link-text">
                    <span class="contact__link-label">{link.label}</span>
                    <span class="contact__link-value">{link.value}</span>
                  </div>
                  <Icon
                    name="lucide:arrow-up-right"
                    size={16}
                    class="contact__link-arrow"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form
        class="contact__form"
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input
          type="hidden"
          name="access_key"
          value={WEB3FORMS_ACCESS_KEY}
        />
        <input type="hidden" name="subject" value="New Portfolio Contact" />
        <input type="hidden" name="from_name" value="Portfolio Contact Form" />
        <input
          type="hidden"
          name="redirect"
          value="https://web3forms.com/success"
        />
        <input type="checkbox" name="botcheck" class="contact__hidden" />

        <div class="contact__field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>

        <div class="contact__field">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
          />
        </div>

        <div class="contact__field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="contact__submit">
          Send message
          <Icon name="lucide:arrow-up-right" size={18} />
        </button>
      </form>
    </div>
  </div>
</section>

<style lang="scss">
  .contact {
    padding: var(--space-4xl) 0;
    border-top: 1px solid var(--color-divider);

    &__container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    &__header {
      margin-bottom: var(--space-3xl);
      max-width: 60ch;
    }

    &__tag {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: var(--space-lg);
    }

    &__title {
      font-size: var(--text-4xl);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: var(--space-md);
    }

    &__lede {
      font-size: var(--text-lg);
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-3xl);

      @media (max-width: 900px) {
        grid-template-columns: 1fr;
        gap: var(--space-2xl);
      }
    }

    &__info-title {
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: var(--space-lg);
    }

    &__links {
      display: flex;
      flex-direction: column;
    }

    &__link {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-md);
      padding: var(--space-md) 0;
      color: var(--color-text);
      border-top: 1px solid var(--color-divider);
      transition: padding var(--duration-fast) var(--ease-out-quart);

      li:last-child & {
        border-bottom: 1px solid var(--color-divider);
      }

      &:hover {
        color: var(--color-text);
        padding-left: var(--space-xs);

        .contact__link-arrow {
          transform: translate(2px, -2px);
        }
      }
    }

    &__link-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    &__link-label {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    &__link-value {
      font-size: var(--text-base);
      color: var(--color-text);
    }

    &__link-arrow {
      color: var(--color-text-muted);
      transition: transform var(--duration-fast) var(--ease-out-quart);
    }

    &__form {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    &__field {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);

      label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      input,
      textarea {
        font-family: var(--font-sans);
        font-size: var(--text-base);
        color: var(--color-text);
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--color-divider);
        padding: var(--space-sm) 0;
        transition: border-color var(--duration-fast) ease;

        &:focus {
          outline: none;
          border-bottom-color: var(--color-text);
        }
      }

      textarea {
        resize: vertical;
        min-height: 8rem;
        line-height: 1.6;
      }
    }

    &__hidden {
      display: none;
    }

    &__submit {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      color: var(--color-text);
      font-size: var(--text-base);
      padding: var(--space-sm) 0;
      border-bottom: 1px solid var(--color-text);
      cursor: pointer;
      transition: gap var(--duration-fast) var(--ease-out-quart);

      svg {
        transition: transform var(--duration-fast) var(--ease-out-quart);
      }

      &:hover {
        gap: var(--space-md);

        svg {
          transform: translate(2px, -2px);
        }
      }
    }
  }
</style>
