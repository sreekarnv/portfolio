---
interface SkillCategory {
  title: string;
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    title: "Languages",
    skills: ["Python", "TypeScript", "JavaScript", "C++", "SQL", "Bash"],
  },
  {
    title: "Backend",
    skills: ["Node.js", "Express", "FastAPI", "REST APIs", "Microservices"],
  },
  {
    title: "Frontend",
    skills: ["React", "Next.js", "SvelteKit", "Vue.js"],
  },
  {
    title: "DevOps & Tools",
    skills: ["Docker", "Jenkins", "GitLab CI/CD", "NGINX", "Linux"],
  },
  {
    title: "Databases",
    skills: ["MongoDB", "PostgreSQL", "Redis", "RabbitMQ"],
  },
];
---

<section class="about" id="about">
  <div class="about__container">
    <header class="about__header">
      <span class="about__tag">01 &mdash; About</span>
      <h2 class="about__title">A developer who likes the whole stack.</h2>
    </header>

    <div class="about__content">
      <div class="about__text">
        <p>
          I started out curious about how things work under the hood, and that
          curiosity took me from tinkering with code at BITS Pilani to
          building real-time analytics dashboards at CleverTap, and eventually
          to engineering protocol-level testing systems at KPIT Technologies.
        </p>
        <p>
          I like the entire stack &mdash; the elegance of a well-designed
          API, the satisfaction of a pixel-perfect interface, and everything
          in between. Most recently I've been working on
          <a href="/projects/fastauth" class="about__link">FastAuth</a>,
          an open-source authentication library for FastAPI, alongside a
          polyglot fintech platform called
          <a href="/projects/mint" class="about__link">Mint</a>.
        </p>
        <p>
          I'm looking for my next chapter &mdash; a team that values craft, a
          problem worth solving, and the space to do meaningful work.
        </p>
      </div>

      <div class="about__skills">
        <h3 class="about__skills-title">Skills</h3>
        <dl class="about__skills-list">
          {
            skillCategories.map((category) => (
              <div class="about__skill-row">
                <dt>{category.title}</dt>
                <dd>
                  {category.skills.map((skill, i) => (
                    <>
                      <span>{skill}</span>
                      {i < category.skills.length - 1 && (
                        <span class="about__skill-sep" aria-hidden="true">
                          &middot;
                        </span>
                      )}
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .about {
    padding: var(--space-4xl) 0;
    border-top: 1px solid var(--color-divider);

    &__container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    &__header {
      margin-bottom: var(--space-3xl);
    }

    &__tag {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: var(--space-lg);
    }

    &__title {
      font-size: var(--text-4xl);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.1;
      max-width: 18ch;
    }

    &__content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);

      @media (max-width: 968px) {
        grid-template-columns: 1fr;
        gap: var(--space-2xl);
      }
    }

    &__text {
      p {
        color: var(--color-text-secondary);
        font-size: var(--text-base);
        line-height: 1.7;
        margin-bottom: var(--space-md);
      }
    }

    &__link {
      color: var(--color-text);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
      transition: color var(--duration-fast) ease;

      &:hover {
        color: var(--color-text-secondary);
      }
    }

    &__skills-title {
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: var(--space-lg);
    }

    &__skills-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }

    &__skill-row {
      display: grid;
      grid-template-columns: 12rem 1fr;
      gap: var(--space-lg);
      align-items: baseline;
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--color-divider);

      @media (max-width: 600px) {
        grid-template-columns: 1fr;
        gap: var(--space-xs);
      }

      dt {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      dd {
        font-size: var(--text-base);
        color: var(--color-text);
        line-height: 1.5;
      }
    }

    &__skill-sep {
      color: var(--color-text-muted);
      margin: 0 var(--space-xs);
    }
  }
</style>
