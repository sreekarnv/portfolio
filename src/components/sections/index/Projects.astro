---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const projectEntries = await getCollection("projects");
const projects = projectEntries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((p) => ({ ...p.data, slug: p.slug }));
---

<section class="projects" id="projects">
  <div class="projects__container">
    <header class="projects__header">
      <span class="projects__tag">03 &mdash; Projects</span>
      <h2 class="projects__title">Selected work.</h2>
    </header>

    <ol class="projects__list">
      {
        projects.map((project, index) => {
          const number = String(index + 1).padStart(2, "0");
          const tech = project.tech.map((t) => t.name);
          const visible = tech.slice(0, 5);
          const extra = tech.length - visible.length;
          return (
            <li class="projects__item">
              <a
                href={`/projects/${project.slug}`}
                class="projects__link"
              >
                <span class="projects__index">{number}</span>
                <div class="projects__body">
                  <h3 class="projects__name">{project.title}</h3>
                  <p class="projects__subtitle">{project.subtitle}</p>
                  <p class="projects__tech">
                    {visible.join(" · ")}
                    {extra > 0 && (
                      <span class="projects__tech-more">
                        {" "}
                        +{extra} more
                      </span>
                    )}
                  </p>
                </div>
                <span class="projects__arrow" aria-hidden="true">
                  <Icon name="lucide:arrow-up-right" size={20} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>

    <div class="projects__footer">
      <a
        href="https://github.com/sreekarnv"
        target="_blank"
        rel="noopener noreferrer"
        class="projects__github"
      >
        View all on GitHub
        <Icon name="lucide:arrow-up-right" size={18} />
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .projects {
    padding: var(--space-4xl) 0;
    border-top: 1px solid var(--color-divider);

    &__container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    &__header {
      margin-bottom: var(--space-3xl);
    }

    &__tag {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: var(--space-lg);
    }

    &__title {
      font-size: var(--text-4xl);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    &__list {
      display: flex;
      flex-direction: column;
    }

    &__item {
      border-top: 1px solid var(--color-divider);

      &:last-child {
        border-bottom: 1px solid var(--color-divider);
      }
    }

    &__link {
      display: grid;
      grid-template-columns: 4rem 1fr 2rem;
      align-items: center;
      gap: var(--space-lg);
      padding: var(--space-lg) 0;
      color: var(--color-text);

      @media (max-width: 768px) {
        grid-template-columns: 3rem 1fr 2rem;
        row-gap: var(--space-sm);
      }

      &:hover {
        .projects__name {
          text-decoration: underline;
          text-underline-offset: 4px;
        }

        .projects__arrow svg {
          transform: translate(3px, -3px);
        }
      }
    }

    &__index {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      letter-spacing: 0.05em;
    }

    &__body {
      min-width: 0;
    }

    &__name {
      font-size: var(--text-2xl);
      font-weight: 600;
      letter-spacing: -0.01em;
      margin-bottom: var(--space-xs);
      transition: color var(--duration-fast) ease;
    }

    &__subtitle {
      color: var(--color-text-secondary);
      font-size: var(--text-sm);
    }

    &__tech {
      margin-top: var(--space-sm);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      letter-spacing: 0.02em;
      line-height: 1.6;
    }

    &__tech-more {
      color: var(--color-text-muted);
      opacity: 0.7;
    }

    &__arrow {
      color: var(--color-text);
      display: inline-flex;
      justify-content: flex-end;

      svg {
        transition: transform var(--duration-fast) var(--ease-out-quart);
      }
    }

    &__footer {
      margin-top: var(--space-2xl);
    }

    &__github {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      color: var(--color-text-secondary);
      font-size: var(--text-sm);
      border-bottom: 1px solid var(--color-divider);
      padding-bottom: 4px;
      transition: color var(--duration-fast) ease;

      &:hover {
        color: var(--color-text);
      }
    }
  }
</style>
